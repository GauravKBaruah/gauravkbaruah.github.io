---
layout: page
---
<div class="people-list">
  {% for profile in page.profiles %}
    <section class="person" aria-labelledby="person-{{ forloop.index }}">
      {% if profile.image -%}
        <img
          src="{{ profile.image | prepend: '/assets/img/' | relative_url }}"
          alt="{{ profile.name | escape }}"
          width="160"
          height="180"
          loading="lazy"
        >
      {%- endif %}
      <div>
        <h2 id="person-{{ forloop.index }}">{{ profile.name }}</h2>
        {% if profile.content %}
          {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture -%}
          {{- profile_content | markdownify -}}
        {%- endif %}
        {% if profile.more_info %}
          <div class="person-meta">{{ profile.more_info }}</div>
        {% endif %}
      </div>
    </section>
  {% endfor %}
</div>
