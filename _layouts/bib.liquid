---
---
<article class="publication-entry" id="{{ entry.key }}">
  <h3 class="publication-title">
    <a href="https://doi.org/{{ entry.doi }}">{{ entry.title }}</a>
  </h3>
  <div class="publication-authors">
    {% assign author_count = entry.author_array | size %}
    {% for author in entry.author_array limit: 6 %}
      {% unless forloop.first %}, {% endunless %}
      {% if author.last == 'Baruah' -%}
        <strong>
          {{- author.first }}
          {{ author.last -}}
        </strong>
      {%- else -%}
        {{- author.first }}
        {{ author.last -}}
      {%- endif %}
    {% endfor %}
    {% if author_count > 6 %}
      <details class="author-details">
        <summary>All {{ author_count }} authors</summary>
        <p>
          {% for author in entry.author_array -%}
            {%- unless forloop.first %}, {% endunless -%}
            {{- author.first }}
            {{ author.last -}}
          {%- endfor %}
        </p>
      </details>
    {% endif %}
  </div>
  <p class="publication-venue">
    {% if entry.journal -%}
      <em>{{ entry.journal }}</em>
    {%- else -%}
      <span class="preprint-label">Preprint</span> {{ entry.publisher -}}
    {%- endif %}
    · {{ entry.year -}}
    {%- if entry.volume %} · {{ entry.volume }}{% endif -%}
    {%- if entry.pages %}: {{ entry.pages }}{% endif %}
  </p>
  <div class="paper-links">
    <a href="https://doi.org/{{ entry.doi }}" aria-label="Read {{ entry.title | escape }}">
      {%- if entry.journal %}Read paper{% else %}Read preprint{% endif %}
      <span aria-hidden="true">↗</span></a
    >
    {% if entry.code -%}
      <a href="{{ entry.code }}">Code</a>
    {%- endif %}
  </div>
  {% if entry.abstract %}
    <details class="paper-abstract">
      <summary>Abstract</summary>
      <p>{{ entry.abstract }}</p>
    </details>
  {% endif %}
</article>
