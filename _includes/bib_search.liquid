{% if site.bib_search %}
  <div class="publication-search">
    <label for="bibsearch">Find a publication</label>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      placeholder="Search by title, author, journal or year"
      aria-describedby="publication-search-status"
    >
    <p id="publication-search-status" class="search-status" role="status" aria-live="polite"></p>
  </div>
{% endif %}
