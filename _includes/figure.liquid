<figure>
  <img
    src="{{ include.path | relative_url }}"
    alt="{{ include.alt | default: include.title | escape }}"
    loading="{{ include.loading | default: 'lazy' }}"
    style="max-width:100%;height:auto;"
  >
  {% if include.caption %}
    <figcaption>{{ include.caption }}</figcaption>
  {% endif %}
</figure>
